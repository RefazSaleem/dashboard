#!/usr/bin/env bash
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF="$DIR/dashboard.conf"
PID_FILE="/tmp/dashboard.pid"

GREEN='\033[0;32m'; CYAN='\033[0;36m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

get_conf() {
  local key="$1" default="$2"
  local val
  val=$(grep -E "^\s*${key}\s*=" "$CONF" 2>/dev/null | head -1 | sed 's/.*=\s*//' | tr -d '"')
  echo "${val:-$default}"
}

PORT=$(get_conf port 8080)
HOST=$(get_conf host 0.0.0.0)

if [ ! -f "$CONF" ]; then
  echo -e "${YELLOW}⚠ dashboard.conf not found — using defaults${NC}"
fi

[ -f "$DIR/.env" ] && source "$DIR/.env"
PYTHON="${DASHBOARD_PYTHON:-python3}"

if ! command -v "$PYTHON" &>/dev/null && [ ! -x "$PYTHON" ]; then
  echo -e "${RED}✗ Python not found: $PYTHON${NC}"; exit 1
fi
echo -e "${GREEN}✓ Python :${NC} $($PYTHON --version) ${CYAN}($PYTHON)${NC}"

cleanup() {
  echo -e "\n${YELLOW}Stopping dashboard...${NC}"
  [ -f "$PID_FILE" ] && kill "$(cat $PID_FILE)" 2>/dev/null; rm -f "$PID_FILE"
  echo -e "${GREEN}Stopped.${NC}"
}
trap cleanup EXIT INT TERM

[ -f "$PID_FILE" ] && kill "$(cat $PID_FILE)" 2>/dev/null; rm -f "$PID_FILE"

echo -e "\n  Starting server..."
"$PYTHON" "$DIR/server.py" &
echo $! > "$PID_FILE"
sleep 1

if ! kill -0 "$(cat $PID_FILE)" 2>/dev/null; then
  echo -e "  ${RED}✗ server.py failed to start${NC}"; exit 1
fi

LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')

echo -e "  ${GREEN}✓ Running${NC} (PID $(cat $PID_FILE))"
echo -e "  ${CYAN}Local :${NC} http://localhost:${PORT}"
echo -e "  ${CYAN}LAN   :${NC} http://${LOCAL_IP}:${PORT}"

wait

